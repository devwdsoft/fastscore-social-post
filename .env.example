# ===== OpenAI =====
OPENAI_API_KEY=sk-...
# Model used to pick stories and write posts (must support JSON schema output)
OPENAI_MODEL=gpt-4.1-mini

# ===== Facebook Page =====
# Page ID and a long-lived PAGE access token with pages_manage_posts + pages_read_engagement
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v21.0

# ===== Telegram review bot =====
# Bot token from @BotFather, and the chat id that receives drafts (your user id or a group id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also send a short "posted" notice to Telegram for auto-published posts
TELEGRAM_NOTIFY_POSTED=true

# ===== Schedule =====
# Cron expression (default: every 3 hours at minute 5) and timezone
CRON_SCHEDULE=5 */3 * * *
TIMEZONE=Asia/Ho_Chi_Minh
# Run one cycle immediately when the process starts
RUN_ON_START=false

# ===== Selection rules =====
# How many posts per run
POSTS_PER_RUN=1
# Only post stories the AI scores at least this high (1-10)
MIN_SCORE=7
# Ignore RSS items older than this
MAX_AGE_HOURS=12

# ===== Review rules =====
# Sensitivity levels: low < medium < high
# Posts whose sensitivity is >= REVIEW_LEVEL go to Telegram for approval; the rest auto-post.
REVIEW_LEVEL=high

# ===== Branding =====
BRAND_NAME=FAST SCORE
BRAND_COLOR=#1B7700
HASHTAG=#fastscore
# App icon shown before FASTSCORE in the logo badge (png/jpg)
APP_ICON=assets/app-icon.png
# Append "Source: <publisher>" to the post text
SOURCE_CREDIT=true

# ===== Misc =====
# true = do everything except publish to Facebook (images saved in data/out)
DRY_RUN=false
# Optional: path to a Chromium/Chrome binary if you don't use `npm run setup-browser`
CHROMIUM_PATH=
